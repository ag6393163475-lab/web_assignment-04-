<%- include('../partials/header') %>

<section class="page-head">
  <h1>Blood requests</h1>
  <p>Move status Pending → Processing → Fulfilled. Fulfilling deducts units from inventory.</p>
</section>

<form class="filter-bar" method="GET" action="/admin/requests">
  <label>
    Status
    <select name="status">
      <option value="">All</option>
      <% statuses.forEach(function(s) { %>
      <option value="<%= s %>" <%= selected === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </label>
  <button class="btn btn-primary" type="submit">Filter</button>
</form>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Requester</th>
        <th>Hospital</th>
        <th>Group</th>
        <th>Units</th>
        <th>Urgency</th>
        <th>Status</th>
        <th>When</th>
        <th>Update</th>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(function(r) { %>
      <tr>
        <td>
          <strong><%= r.requesterName %></strong>
          <div class="muted"><%= r.phone %> · <%= r.city %></div>
        </td>
        <td><%= r.hospital %></td>
        <td><%= r.bloodGroup %></td>
        <td><%= r.unitsNeeded %></td>
        <td><%= r.urgency %></td>
        <td><span class="status status-<%= r.status.toLowerCase() %>"><%= r.status %></span></td>
        <td><%= formatDate(r.createdAt) %></td>
        <td>
          <form class="inline-form" method="POST" action="/admin/requests/<%= r._id %>?_method=PUT">
            <select name="status">
              <% statuses.forEach(function(s) { %>
              <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
            <button class="btn btn-small" type="submit">Save</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (!requests.length) { %>
  <p class="empty">No requests yet.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
